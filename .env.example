# Copy this file to .env and adjust the paths for your machine.
# Relative paths are resolved from the directory where you run a command;
# absolute paths are recommended for external ComfyUI/model locations.

COMFY_DIR=/path/to/ComfyUI
COMFY_PYTHON=/path/to/comfy/python
MODELSCOPE_PYTHON=/path/to/modelscope/python
MINIMAX_MODEL_DIR=/path/to/models/MiniMax-H3

# Runtime data (these defaults can also point inside this repository).
MINIMAX_OUTPUT_DIR=/path/to/minimax/output
MINIMAX_LOG_DIR=/path/to/minimax/logs
MINIMAX_BOT_INPUT_DIR=/path/to/minimax/bot_input
MINIMAX_MODEL_PATHS_CONFIG=/path/to/minimax/.runtime/extra_model_paths.yaml

# Worker service.
MINIMAX_BASE_PORT=8190
MINIMAX_DEFAULT_GPU_COUNT=1
MINIMAX_MAX_GPU_COUNT=8
MINIMAX_RESERVE_VRAM=5
MINIMAX_USE_SAGE_ATTENTION=1
# Initial Bot-wide settings. /mode persists later changes.
MINIMAX_DEFAULT_MODE=fast
MINIMAX_DEFAULT_SECONDS=5
MINIMAX_DEFAULT_DIALOGUE_LANGUAGE=Chinese
# Override these only if the Turbo node/LoRA are not under the normal ComfyUI paths.
# MINIMAX_TURBO_NODE_DIR=/path/to/ComfyUI/custom_nodes/ComfyUI-MiniMax-H3-Turbo
# MINIMAX_TURBO_LORA=/path/to/ComfyUI/models/loras/h3/minimax_h3_turbo_v4_step600_ema.safetensors

# Optional Telegram bot. Obtain a token from @BotFather and list numeric user IDs.
TG_BOT_TOKEN=
TG_ALLOWLIST=123456789
BOT_PYTHON=/path/to/bot/python
# Optional: load Telegram variables from a second shell-compatible env file.
# MINIMAX_BOT_ENV_FILE=/path/to/telegram.env

# Optional download tuning.
MODELSCOPE_DOWNLOAD_PARALLEL_WORKERS=4

# Native H3-Image runs on a separate idle GPU and ComfyUI 0.45+ checkout.
# Its text encoder is shared with the video models under MINIMAX_MODEL_DIR.
# See docs/image-model.md for setup and recommended profiles.
# MINIMAX_IMAGE_COMFY_DIR=/path/to/ComfyUI-image
# MINIMAX_IMAGE_PYTHON=/path/to/image-runtime/python
MINIMAX_IMAGE_PORT=8290
MINIMAX_IMAGE_RESERVE_VRAM=3
# 1: image + video share one queue, one GPU, and the image runtime (loads video Turbo nodes).
# All worker controls then enforce a single GPU; switch models automatically between jobs.
MINIMAX_SHARED_WORKER=0
# Optional: pin an idle GPU; otherwise choose one automatically.
# MINIMAX_IMAGE_GPU=0
